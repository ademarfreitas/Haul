# Haul — modelo de variáveis. Copie para .env.local (fora do Git) e preencha.
# Preencha só o que for usar. Nunca cole estes valores em chat, commit ou print.
# Nada aqui pode ser do Zappy Core ou da Minha Lida: contas, chaves e números próprios do Haul.

# ---------- Banco (Neon, projeto Lister) ----------
# Neon > Lister > branch "dev" > Connect > copiar a connection string (pooled, com sslmode=require).
DATABASE_URL=
# Connection string direta (sem "-pooler" no host), usada só para rodar migrations.
DATABASE_URL_DIRETA=

# ---------- App ----------
NODE_ENV=development
# Endereço público do app (callbacks de OAuth e webhooks apontam para cá).
APP_URL=http://localhost:3000
# Segredo que assina o cookie de login. Trocar este valor desconecta todo mundo. Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SEGREDO_SESSAO=
# Chave para cifrar os tokens dos marketplaces no banco (32 bytes em base64, gerar igual acima).
# Tem de ser a mesma no PC e na hospedagem; se mudar, as conexões precisam ser refeitas.
CHAVE_TOKENS=

# ---------- Mercado Livre (DevCenter: developers.mercadolivre.com.br) ----------
# Passo a passo em docs/mercado-livre.md. O Redirect URI tem de ser https e igual, letra por letra,
# ao cadastrado no app do DevCenter: <APP_URL>/api/canais/mercado-livre/callback
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=https://SEU-ENDERECO/api/canais/mercado-livre/callback

# ---------- Shopee (Open Platform: open.shopee.com) ----------
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=http://localhost:3000/api/canais/shopee/callback
# sandbox ou producao
SHOPEE_AMBIENTE=sandbox

# ---------- Outros canais (depois do MVP) ----------
SHEIN_APP_ID=
SHEIN_APP_SECRET=
AMAZON_SP_CLIENT_ID=
AMAZON_SP_CLIENT_SECRET=
AMAZON_SP_REFRESH_TOKEN=
MAGALU_CLIENT_ID=
MAGALU_CLIENT_SECRET=

# ---------- IA dos anúncios (Anthropic) ----------
ANTHROPIC_API_KEY=

# ---------- Fotos (armazenamento de imagens, ex.: Cloudflare R2 ou S3) ----------
ARMAZENAMENTO_ENDPOINT=
ARMAZENAMENTO_BUCKET=
ARMAZENAMENTO_ACCESS_KEY=
ARMAZENAMENTO_SECRET_KEY=
ARMAZENAMENTO_URL_PUBLICA=

# ---------- E-mail transacional (cadastro, recuperar senha) ----------
EMAIL_API_KEY=
EMAIL_REMETENTE=

# ---------- WhatsApp Business (avisos) — número do Haul, nunca o do Zappy Core ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# Em teste, só mandar para este número (o seu); nunca para cliente real.
WHATSAPP_NUMERO_TESTE=

# ---------- Cobrança da assinatura (provedor a definir; conta própria do Haul) ----------
COBRANCA_API_KEY=
COBRANCA_WEBHOOK_SEGREDO=
# sandbox ou producao
COBRANCA_AMBIENTE=sandbox
